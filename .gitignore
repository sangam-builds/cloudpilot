# ====================================================================
# CloudPilot - Comprehensive .gitignore
# ====================================================================

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.secret

# ====================================================================
# Node / Frontend
# ====================================================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ====================================================================
# Java / Maven / Backend
# ====================================================================
backend/target/
backend/*.class
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.log
backend/dependency-reduced-pom.xml
backend/build/

# ====================================================================
# Python / AI Service
# ====================================================================
ai-service/.venv/
ai-service/venv/
ai-service/env/
ai-service/ENV/
ai-service/__pycache__/
ai-service/*/__pycache__/
ai-service/*/*/__pycache__/
ai-service/*.py[cod]
ai-service/*$py.class
ai-service/.pytest_cache/
ai-service/.coverage
ai-service/htmlcov/
ai-service/*.egg-info/
ai-service/.mypy_cache/
ai-service/.ruff_cache/

# ====================================================================
# Database & Docker local mounts / volumes
# ====================================================================
*.sqlite
*.db
pgdata/
redis_data/

# Logs
logs/
*.log
