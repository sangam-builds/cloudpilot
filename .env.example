# Cloud PostgreSQL Connection URL (Neon / Supabase / Render / AWS RDS)
# Example from Neon: jdbc:postgresql://ep-example-12345.us-east-2.aws.neon.tech/cloudpilot?sslmode=require
CLOUD_DB_URL=jdbc:postgresql://ep-your-subdomain.us-east-2.aws.neon.tech/cloudpilot?sslmode=require
CLOUD_DB_USER=cloudpilot_owner
CLOUD_DB_PASSWORD=your_secure_password_here

